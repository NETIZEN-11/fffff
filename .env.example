# =============================================
# ResumeRank AI - Environment Variables
# =============================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="ResumeRank AI"
NODE_ENV=development

# ---- Database ----
DATABASE_URL="postgresql://postgres:Unicorn%402026@localhost:5432/resumerank_ai"
DIRECT_URL="postgresql://postgres:Unicorn%402026@localhost:5432/resumerank_ai"
# ---- Auth.js ----
AUTH_SECRET="your-auth-secret-minimum-32-chars"
AUTH_URL=http://localhost:3000

# ---- OAuth Providers ----
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="resumes"

# ---- OpenAI ----
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_REWRITE_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ---- Stripe ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
STRIPE_PRO_PRICE_ID="price_your-pro-price-id"
STRIPE_TEAM_PRICE_ID="price_your-team-price-id"

# ---- Resend ----
RESEND_API_KEY="re_NV7P1rbH_Hf5nekw7RQ6rChYEzdqrAUCq"
RESEND_FROM_EMAIL="noreply@resumerank.ai"
RESEND_FROM_NAME="ResumeRank AI"

# ---- Inngest ----
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="signkey-your-inngest-signing-key"

# ---- Redis (Optional - for rate limiting / caching) ----
# Option A: Upstash Redis (recommended for serverless/edge — no package needed)
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Option B: Standard Redis URL (for self-hosted / Railway / Render)
REDIS_URL="redis://localhost:6379"

# ---- Rate Limiting ----
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ---- Feature Flags ----
ENABLE_OCR=false
ENABLE_TEAM_WORKSPACE=true
ENABLE_VIRUS_SCAN=false
